# ========================================
# TAREA A: Gestión Segura de Credenciales
# ========================================
# NUNCA commiteemos estas claves - usar variables de entorno en plataformas de deployment
# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LLM / Vision Provider — set VISION_PROVIDER to switch between processors
# Values: "anthropic" (default, Claude Haiku) | "openai" (legacy GPT-4o-mini)
VISION_PROVIDER=anthropic

# Anthropic (Claude) — primary vision processor
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=1024
# Solo para claves de usuario (sk-ant-usr-...) sin workspace asignado: ID del workspace
# a usar (Console > Settings > Workspaces, empieza con "wrkspc_"). Dejar vacío con claves sk-ant-api03-...
ANTHROPIC_WORKSPACE_ID=
# Max parallel calls to Anthropic API (prevents 429 rate-limit errors on burst uploads)
ANTHROPIC_CONCURRENCY=3
# Max retry attempts when a 429 is received (exponential backoff: 15s, 30s, 60s)
ANTHROPIC_RETRY_MAX=3
ANTHROPIC_RETRY_BASE_DELAY_MS=15000
# Fallback a un modelo más capaz cuando la confianza de la extracción es 'low'.
# Desactivado por defecto (opt-in) para no gastar de más: solo reintenta casos difíciles.
ANTHROPIC_FALLBACK_ENABLED=false
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6

# OpenAI — legacy fallback (only used when VISION_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1
# Reintentos ante 429 (límite de tokens por minuto). Cada comprobante en alta resolución usa ~37k tokens
OPENAI_MAX_RETRIES=6

# ========================================
# TAREA B: Gestión de Secretos en Deployment
# ========================================
# Vector Store Configuration
VECTOR_STORE_URL=your_vector_store_url
VECTOR_STORE_API_KEY=your_vector_store_api_key

# LLM Configuration
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4-vision

# Python Microservice (for embeddings)
EMBEDDINGS_SERVICE_URL=http://localhost:8000

# ========================================
# TAREA D: Implementación de Autenticación
# ========================================
# Lista de IDs de usuarios autorizados (comma-separated)
AUTHORIZED_USERS=123456789,987654321
AUTH_ENABLED=true

# ========================================
# TAREA E: No Repudio (Logging Detallado)
# ========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
ENABLE_AUDIT_LOG=true
AUDIT_LOG_FILE=./logs/audit.log

# ========================================
# TAREA G: Rate Limiting por Usuario
# ========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PER_HOUR=50

# ========================================
# TAREA H: Gestión Efímera de Datos
# ========================================
# Image / temp file retention (hours). For maximal privacy set to 0 to delete immediately after processing.
IMAGE_RETENTION_HOURS=0
TEMP_FILES_CLEANUP_INTERVAL=3600000

# ========================================
# TAREA I: Sanitización y Validación de Input
# ========================================
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/png,image/jpeg,application/pdf
VALIDATE_MAGIC_BYTES=true

# Archivos comprimidos (ZIP con varios comprobantes)
# Tamaño máximo del ZIP (Telegram Bot API no permite descargar más de 20 MB)
ARCHIVE_MAX_SIZE_MB=20
# Máximo de comprobantes procesados por ZIP (cada uno es una llamada a la API de visión)
ARCHIVE_MAX_FILES=30
# Protección contra zip bombs: tamaño total descomprimido permitido
ARCHIVE_MAX_TOTAL_UNCOMPRESSED_MB=100
# Formatos aceptados dentro del ZIP (validados por magic bytes)
ARCHIVE_ALLOWED_FORMATS=jpg,jpeg,png,gif,webp,pdf
# Comprobantes del ZIP procesados en paralelo
ARCHIVE_PROCESSING_CONCURRENCY=3

# ========================================
# Configuración General
# ========================================
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/database
DEBUG=false


